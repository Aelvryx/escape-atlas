{
  "name": "escape-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "validate": "node scripts/validate-data.mjs",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run validate && npm run migration:verify && npm run social:verify && npm test && astro check && astro build",
    "migration:canonical": "tsx scripts/export-canonical-history.ts",
    "migration:verify": "tsx scripts/export-canonical-history.ts --check",
    "import:history": "node scripts/import-reference.mjs",
    "generate:upcoming": "node scripts/generate-upcoming.mjs",
    "social:generate": "tsx scripts/generate-social-cards.ts",
    "social:verify": "tsx scripts/generate-social-cards.ts --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "astro": "^7.0.7",
    "papaparse": "^5.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/papaparse": "^5.5.2",
    "sharp": "^0.35.3",
    "tsx": "^4.23.7",
    "typescript": "^5.9.3"
  }
}
